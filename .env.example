# Copy to `.env` and adjust. Every variable below is optional for local
# development; the defaults in application.yml / application-dev.yml apply when
# a variable is unset. `docker compose` reads this file automatically.
#
# Never commit a real `.env`: the values here are throwaway development ones.

# --- Application -------------------------------------------------------------
SPRING_PROFILES_ACTIVE=dev
# ECS structured JSON logging in the `prod` profile
STRUCTURED_LOG_FORMAT=ecs

# --- PostgreSQL --------------------------------------------------------------
DATABASE_URL=jdbc:postgresql://localhost:5432/hunting_fishing_store
DATABASE_USER=postgres
DATABASE_PASSWORD=postgres
# Consumed by docker compose for the postgres container
POSTGRES_DB=hunting_fishing_store
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# --- Redis (refresh-token revocation, rate limits, password-reset tokens) ----
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- JWT ---------------------------------------------------------------------
# Must be at least 32 characters. `prod` refuses to start without it.
JWT_SECRET_KEY=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION_SECONDS=604800

# --- Cookies -----------------------------------------------------------------
COOKIE_SECURE=false
COOKIE_SAME_SITE=Strict

# --- CORS and rate limiting --------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:5173
RATE_LIMIT_MAX_ATTEMPTS=5
RATE_LIMIT_WINDOW_SECONDS=900

# --- Shipping ----------------------------------------------------------------
SHIPPING_FREE_THRESHOLD=75
SHIPPING_FEE=4.95

# --- Password reset ----------------------------------------------------------
PASSWORD_RESET_BASE_URL=http://localhost:5173/reset-password

# --- Seeded accounts (dev only) ----------------------------------------------
# Admin defaults to admin@huntingfishing.com / Password123! when unset.
# `prod` requires both to be provided explicitly.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Payments ----------------------------------------------------------------
PAYMENT_GATEWAY=stub
# Shared secret used to verify webhook signatures (dev placeholder)
PAYMENT_WEBHOOK_SECRET=local-webhook-secret-change-me
PAYMENT_CHECKOUT_BASE_URL=http://localhost:5173
PAYMENT_MULTIBANCO_ENTITY=21345
PAYMENT_MULTIBANCO_EXPIRY_HOURS=48
PAYMENT_EXPIRY_CRON=0 0 * * * *

# --- Mail (emails are skipped when the host is empty) ------------------------
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
MAIL_FROM=
